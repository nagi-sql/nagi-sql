{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "🌊 [nagi](https://github.com/nagi-sql/nagi) 🌊 Configuration.",
  "type": "object",
  "properties": {
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/definitions/Workspace"
        },
        {
          "type": "null"
        }
      ]
    },
    "lsp": {
      "anyOf": [
        {
          "$ref": "#/definitions/LspOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "anyOf": [
        {
          "$ref": "#/definitions/FormatConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "lint": {
      "anyOf": [
        {
          "$ref": "#/definitions/LintConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "check": {
      "anyOf": [
        {
          "$ref": "#/definitions/TypeCheckOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "anyOf": [
        {
          "$ref": "#/definitions/RulesConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "anyOf": [
        {
          "$ref": "#/definitions/Sources"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "x-tombi-toml-version": "v1.1.0",
  "x-tombi-table-keys-order": "schema",
  "definitions": {
    "Workspace": {
      "title": "Workspace Configuration",
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "anyOf": [
            {
              "$ref": "#/definitions/Sources"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "x-tombi-table-keys-order": "schema"
    },
    "Sources": {
      "title": "Mapping of Data Sources",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_]*$": {
          "$ref": "#/definitions/SourceOrWorkspace"
        }
      },
      "x-tombi-additional-key-label": "source_name"
    },
    "SourceOrWorkspace": {
      "anyOf": [
        {
          "description": "Use an explicit source definition.",
          "allOf": [
            {
              "$ref": "#/definitions/Source"
            }
          ]
        },
        {
          "description": "Inherit source settings from workspace-level configuration.",
          "allOf": [
            {
              "$ref": "#/definitions/InheritWorkspaceSource"
            }
          ]
        }
      ]
    },
    "Source": {
      "title": "Source Dialect",
      "oneOf": [
        {
          "title": "PostgreSQL Source",
          "description": "Configure a PostgreSQL source.",
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "walk": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SourceWalkOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default-database": {
              "type": [
                "string",
                "null"
              ]
            },
            "default-schema": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DisableToggle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lint": {
              "anyOf": [
                {
                  "$ref": "#/definitions/PostgresSourceLintConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "check": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DisableToggle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BooleanDefaultTrue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "migration": {
              "anyOf": [
                {
                  "$ref": "#/definitions/MigrationOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dbt": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DbtOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SourceManifestConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "overrides": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/definitions/SourceOverride"
              }
            },
            "dialect": {
              "type": "string",
              "const": "PostgreSQL"
            }
          },
          "additionalProperties": false,
          "required": [
            "dialect",
            "include"
          ]
        },
        {
          "title": "Snowflake Source",
          "description": "Configure a Snowflake source.",
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "walk": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SourceWalkOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default-database": {
              "type": [
                "string",
                "null"
              ]
            },
            "default-schema": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DisableToggle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lint": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SnowflakeSourceLintConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "check": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DisableToggle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BooleanDefaultTrue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "migration": {
              "anyOf": [
                {
                  "$ref": "#/definitions/MigrationOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dbt": {
              "anyOf": [
                {
                  "$ref": "#/definitions/DbtOptions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SourceManifestConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "overrides": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/definitions/SourceOverride"
              }
            },
            "dialect": {
              "type": "string",
              "const": "Snowflake"
            }
          },
          "additionalProperties": false,
          "required": [
            "dialect",
            "include"
          ]
        }
      ]
    },
    "SourceWalkOptions": {
      "type": "object",
      "properties": {
        "standard-filters": {
          "anyOf": [
            {
              "$ref": "#/definitions/BooleanDefaultTrue"
            },
            {
              "type": "null"
            }
          ],
          "default": true
        }
      },
      "additionalProperties": false
    },
    "BooleanDefaultTrue": {
      "title": "Boolean wrapper with default `true`.",
      "type": "boolean"
    },
    "DisableToggle": {
      "type": "string",
      "enum": [
        "off"
      ]
    },
    "PostgresSourceLintConfig": {
      "anyOf": [
        {
          "$ref": "#/definitions/DisableToggle"
        },
        {
          "$ref": "#/definitions/PostgresLintOptions"
        }
      ]
    },
    "PostgresLintOptions": {
      "type": "object",
      "properties": {
        "allowed-parameter-styles": {
          "anyOf": [
            {
              "$ref": "#/definitions/ParameterStyleSet"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ParameterStyleSet": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ParameterStyle"
      },
      "uniqueItems": true
    },
    "ParameterStyle": {
      "type": "string",
      "enum": [
        "$1",
        "$name",
        "?",
        "?1",
        ":name",
        ":1",
        "@name",
        "%(name)s"
      ]
    },
    "MigrationOptions": {
      "title": "Migration Files Configuration",
      "description": "Narrows the set of source files that contribute DDL (CREATE/ALTER/DROP\nTABLE, CREATE VIEW, CREATE FUNCTION, CREATE TYPE, CREATE INDEX, COMMENT)\nto the schema registry. Files that do not match `include`/`exclude` are\nstill parsed and type-checked as queries, but any DDL they contain is\nignored.\n\nWhen `include` is empty, the migration filter is disabled and every file\nmatched by the surrounding `sources.*.include`/`sources.*.exclude`\nbecomes a DDL source, preserving the previous behavior.",
      "type": "object",
      "properties": {
        "include": {
          "title": "A list of migration files to include for DDL collection.",
          "description": "The files are matched using the glob pattern syntax, evaluated\nrelative to the source root.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "exclude": {
          "title": "A list of migration files to exclude from DDL collection.",
          "description": "The files are matched using the glob pattern syntax, evaluated\nrelative to the source root.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DbtOptions": {
      "title": "dbt Authoring Discovery",
      "description": "Enables artifact-independent discovery from one dbt project contained\nby the source root. The path is validated at the filesystem boundary;\nprofiles, credentials, environment variables, and dbt artifacts are not\nconfiguration inputs.",
      "type": "object",
      "properties": {
        "project-root": {
          "description": "Path to the dbt project root, relative to the surrounding source root.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "project-root"
      ]
    },
    "SourceManifestConfig": {
      "title": "Source Manifest Publication",
      "description": "Opts one source into publishing the language-neutral query manifest.",
      "type": "object",
      "properties": {
        "directory": {
          "description": "Output directory relative to the `nagi.toml` that declares it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "directory"
      ]
    },
    "SourceOverride": {
      "title": "Source File Override",
      "description": "Applies source-local feature toggles to files matched by `include` and not\nmatched by `exclude`.",
      "type": "object",
      "properties": {
        "include": {
          "description": "Glob patterns matched relative to the source root.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "description": "Glob patterns excluded relative to the source root.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "description": "Override formatter enablement for matching files.",
          "anyOf": [
            {
              "$ref": "#/definitions/DisableToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "lint": {
          "description": "Override linter enablement for matching files.",
          "anyOf": [
            {
              "$ref": "#/definitions/DisableToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "description": "Override type checker enablement for matching files.",
          "anyOf": [
            {
              "$ref": "#/definitions/DisableToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "description": "Override governance rule evaluation for matching files.",
          "anyOf": [
            {
              "$ref": "#/definitions/BooleanDefaultTrue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "x-tombi-table-keys-order": "schema"
    },
    "SnowflakeSourceLintConfig": {
      "anyOf": [
        {
          "$ref": "#/definitions/DisableToggle"
        },
        {
          "$ref": "#/definitions/SnowflakeLintOptions"
        }
      ]
    },
    "SnowflakeLintOptions": {
      "type": "object",
      "properties": {
        "allowed-parameter-styles": {
          "anyOf": [
            {
              "$ref": "#/definitions/ParameterStyleSet"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "InheritWorkspaceSource": {
      "title": "Inherit Workspace Data Source",
      "type": "object",
      "properties": {
        "workspace": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace"
      ]
    },
    "LspOptions": {
      "title": "LSP feature toggles",
      "type": "object",
      "properties": {
        "completion": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "formatting": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "goto-definition": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "hover": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "inlay-hint": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "rename": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic-tokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature-help": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace-diagnostics": {
          "anyOf": [
            {
              "$ref": "#/definitions/FeatureToggle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-tombi-table-keys-order": "ascending"
    },
    "FeatureToggle": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "FormatConfig": {
      "anyOf": [
        {
          "$ref": "#/definitions/DisableToggle"
        },
        {
          "$ref": "#/definitions/FormatOptions"
        }
      ]
    },
    "FormatOptions": {
      "title": "Formatter options",
      "type": "object",
      "properties": {
        "case": {
          "title": "Case rules for SQL tokens and identifiers",
          "description": "Groups case policies for identifiers, keywords, data types, and function names.",
          "anyOf": [
            {
              "$ref": "#/definitions/CaseRules"
            },
            {
              "type": "null"
            }
          ]
        },
        "indent-style": {
          "title": "Indentation character style",
          "description": "- `space`: use spaces\n- `tab`: use tabs\n\nThis affects indentation at clause boundaries and multiline lists.\n\n```sql\nSELECT\n    id\nFROM\n    users;\n-- ^ this indentation uses spaces or tabs\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/IndentStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": "space"
        },
        "indent-width": {
          "title": "Indentation width per nesting level",
          "description": "This option is applied when `indent-style = \"space\"`.\n\n```sql\nSELECT\n    id\nFROM\n    users;\n-- ^ width = 4 example\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/IndentWidth"
            },
            {
              "type": "null"
            }
          ],
          "default": 4
        },
        "line-width": {
          "title": "Maximum target line width",
          "description": "Formatter tries to keep lines within this width by moving lists/clauses to multiline when needed.\n\n```sql\n-- narrow line-width\nSELECT\n    id,\n    name\nFROM\n    users;\n\n-- wide line-width\nSELECT id, name FROM users;\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/LineWidth"
            },
            {
              "type": "null"
            }
          ],
          "default": 80
        },
        "line-ending": {
          "title": "Line ending style",
          "description": "- `auto`: use CRLF when the raw source contains CRLF; otherwise use LF\n- `lf`: always use LF\n- `crlf`: always use CRLF\n\nFormatter-preserved token content, such as multiline string literals,\nremains byte-exact. When an embedded formatter rewrites a token body,\nthis policy applies to the line breaks generated in that body.",
          "anyOf": [
            {
              "$ref": "#/definitions/LineEnding"
            },
            {
              "type": "null"
            }
          ],
          "default": "auto"
        }
      },
      "additionalProperties": false,
      "x-tombi-table-keys-order": "schema"
    },
    "CaseRules": {
      "type": "object",
      "properties": {
        "identifiers": {
          "title": "The case style for unquoted SQL identifiers",
          "description": "Controls general identifiers such as database, schema, table, column,\nand alias names. Quoted identifiers preserve their source spelling.\n\n```sql\n-- lowercase\nSELECT account_id FROM analytics.daily_accounts;\n\n-- uppercase\nSELECT ACCOUNT_ID FROM ANALYTICS.DAILY_ACCOUNTS;\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/LowerCaseStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": "lowercase"
        },
        "keywords": {
          "title": "The case style for SQL keywords",
          "description": "Controls tokens like `SELECT`, `FROM`, `WHERE`, `INSERT`, `RETURNING`.\n\n```sql\n-- lowercase\nselect id from users;\n\n-- uppercase\nSELECT id FROM users;\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/UpperCaseStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": "uppercase"
        },
        "datatypes": {
          "title": "The case style for SQL data types",
          "description": "Controls tokens like `INT`, `VARCHAR`, `TIMESTAMP WITH TIME ZONE`.\n\nAccepts either a single case style applied to built-in data types, or\na table that splits the policy between built-in and user-defined types.\n\n```sql\n-- lowercase\nSELECT now()::timestamp with time zone;\n\n-- uppercase\nSELECT now()::TIMESTAMP WITH TIME ZONE;\n```",
          "anyOf": [
            {
              "$ref": "#/definitions/CategoryCaseRule"
            },
            {
              "type": "null"
            }
          ],
          "default": {
            "built-in": "uppercase",
            "user-defined": "lowercase"
          }
        },
        "functions": {
          "title": "The case style for function names",
          "description": "Applies uniformly to every function name (built-in and user-defined\nalike). Unlike `datatypes`, this does not split by built-in vs.\nuser-defined: distinguishing them requires a per-dialect catalog of\nknown built-in function names, which formatters working from a single\nfile without semantic resolution do not have.",
          "anyOf": [
            {
              "$ref": "#/definitions/UpperCaseStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": "uppercase"
        }
      },
      "additionalProperties": false,
      "x-tombi-table-keys-order": "schema"
    },
    "LowerCaseStyle": {
      "description": "Wrapper around `CaseStyle` for fields that default to lowercase.",
      "allOf": [
        {
          "$ref": "#/definitions/CaseStyle"
        }
      ]
    },
    "CaseStyle": {
      "oneOf": [
        {
          "description": "Render tokens in uppercase (for example, `SELECT`, `INT`).",
          "type": "string",
          "const": "uppercase"
        },
        {
          "description": "Render tokens in lowercase (for example, `select`, `int`).",
          "type": "string",
          "const": "lowercase"
        }
      ]
    },
    "UpperCaseStyle": {
      "description": "Wrapper around `CaseStyle` for fields that default to uppercase.",
      "allOf": [
        {
          "$ref": "#/definitions/CaseStyle"
        }
      ]
    },
    "CategoryCaseRule": {
      "description": "Case policy for data types.\n\nAccepts either a single [`CaseStyle`] applied uniformly, or a table that\nsplits the policy between built-in and user-defined names.\n\n```toml\n# uniform: applies to every data type name\n[format.case]\ndatatypes = \"uppercase\"\n\n# split: built-in uppercase, user-defined lowercase\n[format.case.datatypes]\nbuilt-in = \"uppercase\"\nuser-defined = \"lowercase\"\n```",
      "anyOf": [
        {
          "description": "A single case style applied to both built-in and user-defined names.",
          "allOf": [
            {
              "$ref": "#/definitions/CaseStyle"
            }
          ]
        },
        {
          "description": "Separate case styles for built-in and user-defined names.",
          "allOf": [
            {
              "$ref": "#/definitions/CategoryCaseSplit"
            }
          ]
        }
      ]
    },
    "CategoryCaseSplit": {
      "title": "Split case styles for built-in vs user-defined names",
      "type": "object",
      "properties": {
        "built-in": {
          "title": "Case style for built-in (dialect-provided) names",
          "description": "Applies to names provided by the SQL dialect, such as built-in\nfunctions (`count`, `now`) or built-in data types (`int`, `text`).",
          "anyOf": [
            {
